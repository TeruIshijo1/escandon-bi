# ════════════════════════════════════════════
# Hospital Escandón BI — Variables de Entorno
# Copia este archivo a .env y configura cada valor
# NUNCA subas .env a control de versiones
# ════════════════════════════════════════════

# ── Servidor ─────────────────────────────────
NODE_ENV=development
PORT=4000

# ── Base de Datos PostgreSQL ────────────────────
# PostgreSQL aloja TODA la persistencia de la plataforma (auth, auditoría,
# configuraciones BI/KPI, calidad de datos, datahub y legado clínico).
# Por defecto se conecta a localhost:5432 con el usuario del PG local.
PGUSER=postgres
PGHOST=localhost
PGPASSWORD=
PGDATABASE=escandon_bi
PGPORT=5432

# ── Administrador inicial ──────────────────────
# Solo se crea durante db:init cuando SEED_ADMIN_PASSWORD tiene valor.
# Configura la contraseña únicamente en tu archivo .env local.
SEED_ADMIN_USERNAME=admin
SEED_ADMIN_NAME=Administrador Inicial
SEED_ADMIN_EMAIL=admin@example.invalid
SEED_ADMIN_PASSWORD=

# ── JWT ───────────────────────────────────────
# Genera con: openssl rand -hex 64
JWT_SECRET=CAMBIA_ESTO_POR_UN_SECRETO_DE_AL_MENOS_64_CARACTERES_HEXADECIMALES
JWT_REFRESH=CAMBIA_ESTO_POR_OTRO_SECRETO_DIFERENTE_PARA_REFRESH_TOKENS
JWT_EXPIRY=8h

# ── CORS ──────────────────────────────────────
CORS_ORIGIN=http://localhost:5173

# ── OpenAI / Azure OpenAI ─────────────────────
OPENAI_API_KEY=
OPENAI_MODEL=gpt-4o
# Para Azure OpenAI (descomentar si aplica):
# AZURE_OPENAI_ENDPOINT=https://TU-RECURSO.openai.azure.com/openai/deployments/gpt-4o

# ── Base de Datos Remota (SQL Server) ─────────────────

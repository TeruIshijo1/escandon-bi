# ════════════════════════════════════════════
# Hospital Escandón BI — Variables de Entorno
# Copia este archivo a .env y configura cada valor
# NUNCA subas .env a control de versiones
# ════════════════════════════════════════════

# ── Servidor ─────────────────────────────────
NODE_ENV=development
PORT=4000

# ── Base de Datos PostgreSQL ────────────────────
# PostgreSQL aloja TODA la persistencia de la plataforma (auth, auditoría,
# configuraciones BI/KPI, calidad de datos, datahub y legado clínico).
# Por defecto se conecta a localhost:5432 con el usuario del PG local.
PGUSER=postgres
PGHOST=localhost
PGPASSWORD=
PGDATABASE=escandon_bi
PGPORT=5432

# Estadísticas: copia mensual persistente en PostgreSQL de BI.
# El mes actual y el anterior se revisan cada 15 minutos; los meses cerrados
# se revisan en rotación cuando cumplen 24 horas desde su última validación.
STATISTICS_SYNC_MINUTES=15
STATISTICS_CLOSED_RECHECK_MINUTES=1440
STATISTICS_FAILED_RETRY_MINUTES=60
STATISTICS_MONTH_BUDGET_MINUTES=10

# ── Administrador inicial ──────────────────────
# Solo se crea durante db:init cuando SEED_ADMIN_PASSWORD tiene valor.
# Configura la contraseña únicamente en tu archivo .env local.
SEED_ADMIN_USERNAME=admin
SEED_ADMIN_NAME=Administrador Inicial
SEED_ADMIN_EMAIL=admin@example.invalid
SEED_ADMIN_PASSWORD=

# ── JWT ───────────────────────────────────────
# Genera con: openssl rand -hex 64
JWT_SECRET=CAMBIA_ESTO_POR_UN_SECRETO_DE_AL_MENOS_64_CARACTERES_HEXADECIMALES
JWT_REFRESH=CAMBIA_ESTO_POR_OTRO_SECRETO_DIFERENTE_PARA_REFRESH_TOKENS
JWT_EXPIRY=8h

# ── CORS ──────────────────────────────────────
# Opcional: origenes permitidos separados por coma. Intranet, Tailscale y localhost estan permitidos automaticamente.
CORS_ORIGIN=http://localhost:5173

# ── OpenAI / Azure OpenAI ─────────────────────
# ARIA (asistente IA) acepta cualquiera de estos proveedores:
GEMINI_API_KEY=
GEMINI_MODEL=gemini-3.5-flash-lite
DEEPSEEK_API_KEY=
DEEPSEEK_MODEL=deepseek-chat
OPENAI_API_KEY=
OPENAI_MODEL=gpt-4o
# Reservas del asistente de reportes: habilitar explícitamente, por ejemplo openai o openai,deepseek.
# Cada reserva necesita su propia clave de API nativa y saldo/cuota disponibles.
# Vacío mantiene sólo el proveedor principal. No acepta nombres de endpoints.
REPORT_AI_FALLBACK_PROVIDERS=
# Modelos Gemini de reserva opcionales, separados por coma (Flash/Lite estables).
# Se prueban antes del descubrimiento automático. Un Flash explícito permite respaldo de un Lite.
REPORT_AI_GEMINI_FALLBACK_MODELS=gemini-3.5-flash,gemini-3.6-flash
# Base URL opcional si se usa un proxy/endpoint propio:
LLM_BASE_URL=
# Para Azure OpenAI (descomentar si aplica):
# AZURE_OPENAI_ENDPOINT=https://TU-RECURSO.openai.azure.com/openai/deployments/gpt-4o

# ── SQL Server Remoto (VERTICAL / KH_HE) ─────
# Cliente mssql hacia el SQL Server remoto del hospital
# (config/remote-db.js — usado por los módulos que leen VERTICAL)
REMOTE_DB_USER=
REMOTE_DB_PASS=
REMOTE_DB_SERVER=100.121.115.8
REMOTE_DB_NAME=KH_HE
REMOTE_DB_PORT=1433

# Reapertura de cuentas: carpeta en el equipo que ejecuta el backend.
# El servicio no modifica Vertical si no puede guardar y verificar el respaldo.
ACCOUNT_REOPENING_BACKUP_DIR=D:\Escritorio\Reaperturas

# ── API SITI (sistema legado) ─────────────────
# (config/siti-api.js)
SITI_API_URL=http://192.168.254.21:9000
SITI_USER=
SITI_PASS=

# ── SAP B1 Service Layer ──────────────────────
# (config/sap.config.js — sincronización de inventario)
SAP_BASE_URL=https://sl.hospesc.com:50000/b1s/v2
SAP_COMPANY_DB=SBO_HE2
SAP_USERNAME=manager
SAP_PASSWORD=
SAP_REJECT_UNAUTHORIZED=true
SAP_MAX_CONCURRENT_REQUESTS=3
SAP_QUERY_DEFINITION_TTL_MS=3600000

# Ventanas y reintentos de los tableros guardados
DASHBOARD_SYNC_RECENT_DAYS=2
DASHBOARD_SYNC_RECHECK_MINUTES=1440
DASHBOARD_SYNC_RETRY_MINUTES=15

# Opciones de honorarios y conciliación (sin cambiar importes autorizados)
HONORARIOS_CATALOG_SYNC_MINUTES=30
HONORARIOS_DISCOVERY_MONTHS=12
SAP_LOCAL_CURRENCY=MXN
